# Hugging Face Access Token (Required for downloading gated models like Llama-3)
HF_TOKEN=your_huggingface_token_here

# Weights & Biases API Key (Required for experiment tracking)
WANDB_API_KEY=your_wandb_api_key_here

# OpenAI API Key (Required if using OpenAI models for evaluation)
OPENAI_API_KEY=your_openai_api_key_here
